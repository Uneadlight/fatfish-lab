{
  "name": "@un10086/dsh-papers-panel",
  "version": "0.1.0",
  "description": "把论文库搬到侧边栏：左侧栏一个图标点开，就是论文列表、arXiv 检索与一键导入。数据复用已装的 Agentero 论文插件（/agentero/api），不另建库。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "papers",
    "arxiv",
    "agentero",
    "sidebar"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "license": "MIT",
  "author": "大肥鱼",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}

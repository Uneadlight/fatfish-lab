{
  "name": "dsh-memory",
  "version": "0.4.9",
  "description": "为 DeepSeek Harness 的长期记忆库：跨会话保存、搜索、列出、遗忘记忆，并在系统提示中自动注入最重要的记忆；侧边栏提供「记忆库」入口与可视化页面。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.png"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.png",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
